{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ariranhacast-lobby",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Versão web do app (assistir pelo site) em /web/. Gerada no deploy por: node scripts/build-mobile.mjs --web
  // O Worker roda antes dos arquivos: as rotas do lobby continuam iguais e só /web/ vem daqui.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],

  // Client IDs não são segredos. Deixe vazio o provedor que não for usar.
  // Os segredos vão com: npx wrangler secret put DISCORD_CLIENT_SECRET (e GOOGLE_CLIENT_SECRET)
  "vars": {
    "DISCORD_CLIENT_ID": "1572274313103548437",
    "GOOGLE_CLIENT_ID": ""
  }
}
